# Dependencies
node_modules/
.pnp
.pnp.js

# Build artifacts (regenerated by CI for gh-pages)
# Keep dist tracked locally — gh-pages workflow uses it. But ignore caches:
.cache/
.parcel-cache/

# Environment / secrets — NEVER commit these
.env
.env.*
*.env
*Credentials*
*Secret*
*Config.local*
*.pem
*.key

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Hyperframes work caches
motion/.hf-cache/
motion/.frames/
motion/dist-tmp/

# Intermediate render staging — final renders are committed under dist/motion/
motion/dist/
